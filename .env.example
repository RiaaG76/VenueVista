# ===================================================================
# VenueVista Environment Configuration Template
# Copy this file to .env or set environment variables before running.
# DO NOT commit real secrets or credentials to source control.
# ===================================================================

# Server Port (Default: 8081)
SERVER_PORT=8081

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/venuevista_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JWT Signing Secret (REQUIRED)
# Must be at least 256 bits (32 characters / bytes) of entropy for HMAC-SHA256.
# Application startup will FAIL if this variable is missing or shorter than 32 characters.
# Generate a secure key in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
VENUEVISTA_JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARACTERS_PLACEHOLDER

# JWT Expiration in milliseconds (Default: 86400000 = 24 hours)
VENUEVISTA_JWT_EXPIRATION_MS=86400000
